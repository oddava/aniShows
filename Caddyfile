{
}

{$DOMAIN_NAME:localhost} {

    encode gzip zstd

    # API
    handle /api/* {
        reverse_proxy web:8000
    }

    # WebSockets are served by the same ASGI app as the API
    handle /ws/* {
        reverse_proxy web:8000
    }

    # Django Admin (backend)
    handle /django-admin/* {
        reverse_proxy web:8000
    }

    # Django static (optional)
    handle /static/* {
        reverse_proxy web:8000
    }

    # MinIO Media - proxy /media/* to MinIO bucket
    # Note: /media/CACHE/* is also handled here when thumbnails are in S3
    handle_path /media/* {
        # Fix MIME types for common image formats (MinIO sometimes returns application/octet-stream)
        @webp path *.webp
        header @webp Content-Type "image/webp"

        @jpg path *.jpg *.jpeg
        header @jpg Content-Type "image/jpeg"

        @png path *.png
        header @png Content-Type "image/png"

        @gif path *.gif
        header @gif Content-Type "image/gif"

        rewrite * /anishows-media/media{path}
        reverse_proxy minio:9000 {
            header_up Host {upstream_hostport}
            # Strip CORS headers from MinIO to avoid duplicates
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            # Strip upstream content type so extension-based header rules
            # below set a single canonical Content-Type.
            header_down -Content-Type
        }

        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Cache-Control "public, max-age=31536000, immutable"
        }
    }

    # ImageKit CACHE - serve locally generated thumbnails (Unused when USE_S3=True)
    # handle_path /media/CACHE/* {
    #     root * /app/CACHE
    #     file_server
    #     header {
    #         Access-Control-Allow-Origin "*"
    #         Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    #         Cache-Control "public, max-age=31536000, immutable"
    #     }
    # }

    # Metrics endpoint
    handle /metrics {
        reverse_proxy web:8000
    }

    # Serve user-specific profile link previews for major crawlers/bots.
    @profile_share_crawlers {
        path /u/*
        header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|discordbot|whatsapp|telegram(?:bot)?|linkedinbot|skypeuripreview|googlebot|bingbot|duckduckbot|applebot|pinterestbot|vkshare|line|kakaotalk-scrap)
    }
    handle @profile_share_crawlers {
        reverse_proxy web:8000
    }

    # Vite HMR (WebSocket) - required for hot reload
    handle /vite-hmr {
        reverse_proxy frontend:5173
    }

    # Frontend - Proxy to Vite dev server
    handle {
        reverse_proxy frontend:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    header {
        Permissions-Policy "interest-cohort=()"
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
    }

    log {
        output file /var/log/caddy/access.log
    }
}
