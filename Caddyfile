{
    email {$EMAIL_HOST_USER}
}

{$DOMAIN_NAME:localhost} {

    encode gzip zstd

    # API
    handle /api/* {
        reverse_proxy web:8000
    }

    # Django Admin (backend)
    handle /django-admin/* {
        reverse_proxy web:8000
    }

    # Django static (optional)
    handle /static/* {
        reverse_proxy web:8000
    }

    # ImageKit CACHE - serve locally generated thumbnails
    handle_path /media/CACHE/* {
        root * /app/CACHE
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # MinIO Media - proxy /media/* to MinIO bucket
    handle_path /media/* {
        rewrite * /anishows-media/media{path}
        reverse_proxy minio:9000 {
            header_up Host {upstream_hostport}
        }
    }

    # Vite HMR (WebSocket) - required for hot reload
    handle /vite-hmr {
        reverse_proxy frontend:5173
    }

    # Frontend - Proxy to Vite dev server
    handle {
        reverse_proxy frontend:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    header {
        Permissions-Policy "interest-cohort=()"
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
    }

    log {
        output file /var/log/caddy/access.log
    }
}
