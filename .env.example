# Copy to .env. Secrets and environment-specific values only; tuning defaults
# live in root/settings/base.py and can be overridden here when needed.
# docker-compose.yml already points dev services at db/redis/minio, so the
# connection values below matter mostly for production.

# Django
DJANGO_ENV=development            # development | production (default: production)
DJANGO_SECRET_KEY=change_me_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database
DB_NAME=anishows_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_USE_PGBOUNCER=False            # production uses PgBouncer (docker-compose.prod.yml)

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0

# Media storage (MinIO locally, any S3-compatible store in production)
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=anishows-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
MINIO_PUBLIC_DOMAIN=localhost:5173
CDN_BASE_URL=

# URLs
FRONTEND_URL=http://localhost:5173
DOMAIN_NAME=http://localhost
CADDY_ACME_EMAIL=admin@anishows.local
CORS_ALLOWED_ORIGINS=             # production only, comma-separated
CSRF_TRUSTED_ORIGINS=             # production only, comma-separated
# Proxies whose X-Forwarded-For is trusted for the client IP. Production
# defaults to the private ranges (Docker network); see docker-compose.prod.yml.
TRUSTED_PROXY_CIDRS=

# Auth
JWT_ISSUER=anishows.com
JWT_AUDIENCE=anishows-api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# External data
# Public Jikan. If it's unreachable from your network, run the self-hosted one
# (docker compose --profile jikan up -d) and use http://jikan:8080/v4.
JIKAN_BASE_URL=https://api.jikan.moe/v4
MAL_CLIENT_ID=

# Email (Resend)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="AniShows <onboarding@resend.dev>"

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
METRICS_USERNAME=admin
METRICS_PASSWORD=change_me

# Umami analytics (optional: docker compose --profile analytics up -d)
UMAMI_DB_PASSWORD=change_me
UMAMI_APP_SECRET=change_me
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
# Caddyfile.prod serves Umami on this host and allows it in the SPA's CSP.
# Both are required in production (Caddy refuses an empty site address).
UMAMI_DOMAIN=stats.example.com
UMAMI_PUBLIC_ORIGIN=https://stats.example.com

# Backups: how many backups of each kind (regular, pre-restore) to keep.
# Each holds a full DB dump and MinIO archive, so size the disk for it.
BACKUP_KEEP=1
