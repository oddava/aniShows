# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=change_me_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database
DB_NAME=anishows_db
DB_USER=postgres
DB_PASSWORD=1
DB_HOST=pgbouncer
DB_PORT=6432

# PgBouncer (connection pooling)
DB_USE_PGBOUNCER=True
DB_PGBOUNCER_HOST=pgbouncer
DB_PGBOUNCER_PORT=6432
PGBOUNCER_DB_HOST=db
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

# Read replicas (optional)
DB_ENABLE_READ_REPLICA_ROUTING=False
DB_REPLICA_HOSTS=
# DB_REPLICA_1_NAME=anishows_db
# DB_REPLICA_1_USER=postgres
# DB_REPLICA_1_PASSWORD=1
# DB_REPLICA_1_PORT=5432
# DB_REPLICA_PORT=5432

# Redis (with authentication support)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0

# Redis Sentinel (optional HA mode)
REDIS_SENTINEL_ENABLED=False
REDIS_SENTINEL_SERVICE_NAME=mymaster
REDIS_SENTINEL_NODES=redis-sentinel-1:26379,redis-sentinel-2:26379

# MinIO / S3
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=anishows-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
MINIO_PUBLIC_DOMAIN=localhost:9000

# CDN (optional)
CDN_BASE_URL=
STATIC_CDN_URL=
MEDIA_CDN_URL=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Frontend URL (for OAuth callback)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated production origins)
CORS_ALLOWED_ORIGINS=

# JWT Configuration
JWT_ISSUER=anishows.com
JWT_AUDIENCE=anishows-api

# MyAnimeList API (required for MAL imports)
MAL_CLIENT_ID=your_mal_client_id

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password


# Metrics auth
METRICS_USERNAME=admin
METRICS_PASSWORD=change-me-in-production

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GRAFANA_ROOT_URL=http://localhost:3000

# Prometheus Retention (days)
PROMETHEUS_RETENTION_DAYS=15

# Sentry Error Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
