# Production environment for aniShows. Copy to .env on the server (chmod 600)
# and replace every <...> value. This is the one list of production variables
# (G7); apps/core/tests/test_env_template.py fails when a setting reads a
# variable that is missing here. Development uses .env.example instead.
#
# Quote values that contain spaces. deploy-prod.sh refuses placeholders for the
# secrets marked [refused]. Commented lines show the code default.
#
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Target described here: shared VPS behind its existing reverse proxy (proxy
# mode), domain anishows.com.

# ---------------------------------------------------------------- Django
DJANGO_ENV=production
# [refused] placeholder or shorter than 50 characters
DJANGO_SECRET_KEY=<generate: 64+ random characters>
# Public host names only (no "*"). deploy-prod.sh refuses local-only values.
ALLOWED_HOSTS=anishows.com,www.anishows.com
# Added by production.py for in-network probes (Docker/Caddy health checks,
# deploy smoke test); never reachable from outside. Empty = off.
# ALLOWED_HOSTS_INTERNAL=localhost,127.0.0.1,web
FRONTEND_URL=https://anishows.com
CORS_ALLOWED_ORIGINS=https://anishows.com,https://www.anishows.com
CSRF_TRUSTED_ORIGINS=https://anishows.com,https://www.anishows.com
# Domain the deploy smoke-tests and (public mode) Caddy serves.
DOMAIN_NAME=anishows.com
# Structured logs: json (default) or text (the old plain format).
LOG_FORMAT=json
# Set by the image (Dockerfile ARG GIT_SHA); only override for a local build.
# GIT_SHA=

# ---------------------------------------------------------------- Edge and proxy chain
# proxy (default): the host's existing reverse proxy (nginx, Caddy, Traefik)
#   terminates TLS and forwards to our Caddy on 127.0.0.1:CADDY_PROXY_PORT.
# public: Caddy owns 80/443 + ACME.  tunnel: Cloudflare Tunnel, no host ports.
# docs/deploy/DEPLOY.md has the upstream proxy's config for each case.
CADDY_MODE=proxy
# Proxy mode: where Caddy listens on the host (infra/compose/proxy-port.yml).
# CADDY_PROXY_BIND=127.0.0.1
# CADDY_PROXY_PORT=8080
# 0 = no host port: the proxy is a container and Caddy joins its network
# (COMPOSE_EXTRA_FILES="infra/compose/shared-proxy-network.yml", PROXY_NETWORK).
# CADDY_PROXY_PUBLISH=1
# PROXY_NETWORK=proxy
# The app's Docker network (fixed, so the two trust lists below can name it).
# Change it if it overlaps a network on the host.
# APP_SUBNET=10.250.250.0/25
# [refused when unset or wide] Peers allowed to set the client IP and the
# scheme (X-Forwarded-For / X-Forwarded-Proto), space-separated. Proxy mode:
# the host's proxy as Caddy sees it, i.e. the Docker gateway of APP_SUBNET
# for a proxy on the host (10.250.250.1/32 with the default APP_SUBNET), or
# the proxy container's fixed IP with shared-proxy-network.yml; plus
# 127.0.0.1/8 ::1/128. Tunnel with the in-stack cloudflared: derived
# (EDGE_SUBNET + loopback). TUNNEL_EXTERNAL=1: that cloudflared's address.
CADDY_TRUSTED_PROXIES="<the host proxy's address as Caddy sees it, e.g. 10.250.250.1/32> 127.0.0.1/8 ::1/128"
# Where trusted peers put the client IP. Derived: X-Forwarded-For (proxy,
# public), CF-Connecting-IP (tunnel).
# CADDY_CLIENT_IP_HEADERS=X-Forwarded-For
# Tunnel mode only. Remotely managed tunnel token (Cloudflare Zero Trust >
# Networks > Tunnels); its public hostnames point at http://caddy:80.
TUNNEL_TOKEN=
# 1 = cloudflared runs outside this stack (host service or a shared container;
# then add infra/compose/loopback-port.yml or shared-tunnel-network.yml).
TUNNEL_EXTERNAL=0
# COMPOSE_EXTRA_FILES="infra/compose/shared-tunnel-network.yml"
# TUNNEL_NETWORK=cloudflared
# CADDY_LOOPBACK_PORT=8080
# Derived from CADDY_MODE by scripts/deploy/env.sh (deploy-prod.sh and
# scripts/deploy/compose.sh); set only to override. Run manual compose
# commands through scripts/deploy/compose.sh so they get the same values.
# CADDY_SITE_ADDRESS=:80
# CADDY_UMAMI_SITE_ADDRESS=http://stats.anishows.com
# The Caddy <-> cloudflared network (only those two). Change it if it
# overlaps a network on the host.
# EDGE_SUBNET=10.250.250.240/29
# Django upstreams for Caddy.
# WEB_UPSTREAMS=web:8000
# Public mode only: ACME account email.
# CADDY_ACME_EMAIL=<ops-email>
# D-9: who may reach /metrics, /api/v1/health/ready/ and /django-admin/
# (space-separated CIDRs, matched against the real client IP). Empty = nobody
# from outside (403; Caddy's own loopback still passes for the deploy's smoke
# tests). deploy-prod.sh refuses wide-open ranges (e.g. 0.0.0.0/0, ::/0)
# unless ALLOW_WIDE_ADMIN_CIDRS=1.
# ADMIN_ALLOW_CIDRS="203.0.113.10/32 2001:db8::/48"
ADMIN_ALLOW_CIDRS=
# ALLOW_WIDE_ADMIN_CIDRS=0
# The app trusts exactly one proxy (Caddy); keep 1 (docs/deploy/tunnel.md).
DRF_NUM_PROXIES=1
# [refused when unset or wide; Compose also refuses it unset] Django believes
# X-Forwarded-For only from these peers (comma-separated): Caddy, on APP_SUBNET.
TRUSTED_PROXY_CIDRS=<APP_SUBNET, e.g. 10.250.250.0/25>
SECURE_SSL_REDIRECT=True
# HSTS: on; includeSubDomains and preload off (owner decision G7 Q1: they
# reach every subdomain, and preload is hard to undo). True turns each on.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Derived from the three above by deploy-prod.sh.
# CADDY_HSTS_HEADER=max-age=31536000
# Smoke-test the public path after the deploy (through the host's proxy).
PUBLIC_BASE_URL=https://anishows.com

# ---------------------------------------------------------------- Database
# db = the bundled Postgres (bundled-db profile). Any other host = external.
DB_HOST=db
DB_PORT=5432
DB_NAME=anishows_db
DB_USER=anishows
# [refused]
DB_PASSWORD=<generate>
# External/shared Postgres: require, or verify-full with the CA mounted by
# infra/compose/db-ca.yml (DB_CA_FILE on the host -> DB_SSLROOTCERT inside).
DB_SSLMODE=
DB_SSLROOTCERT=
# DB_CA_FILE=/srv/anishows/db-ca.pem
# Pooled connections per process. Budget: DB_POOL_MAX_SIZE x (GUNICORN_WORKERS
# x (SCALE_WEB + 1 during a roll) + CELERY_CONCURRENCY + 2) + a few for
# manage.py/backups <= the role's CONNECTION LIMIT (runbook: lean 5 x 7 + 10 = 45).
DB_POOL_MAX_SIZE=5
# Ignored while the pool is on.
# DB_CONN_MAX_AGE=600
# Search typo tolerance (pg_trgm word similarity, 0.1-1.0).
# SEARCH_WORD_SIMILARITY_THRESHOLD=0.5

# ---------------------------------------------------------------- Redis
REDIS_HOST=redis
REDIS_PORT=6379
# [refused]
REDIS_PASSWORD=<generate>
REDIS_DB=0
REDIS_MAXMEMORY=128mb
# Only when REDIS_PASSWORD is empty (not recommended):
# REDIS_URL=
# CELERY_BROKER_URL=
# REDIS_CACHE_MAX_CONNECTIONS=500
# REDIS_CHANNEL_LAYER_CAPACITY=3000
# REDIS_CHANNEL_LAYER_EXPIRY=15
# REDIS_CHANNEL_LAYER_GROUP_EXPIRY=86400
# CELERY_BROKER_POOL_LIMIT=100

# ---------------------------------------------------------------- Media storage (MinIO)
USE_S3=True
AWS_ACCESS_KEY_ID=anishows
# [refused] also MinIO's root password
AWS_SECRET_ACCESS_KEY=<generate>
AWS_STORAGE_BUCKET_NAME=anishows-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
# Media URLs are https://<this>/media/... (Caddy proxies /media to MinIO).
MINIO_PUBLIC_DOMAIN=anishows.com
MINIO_USE_SSL=True
CDN_BASE_URL=
# STATIC_CDN_URL=
# MEDIA_CDN_URL=
# AWS_S3_CONNECT_TIMEOUT=3
# AWS_S3_READ_TIMEOUT=10
# AWS_S3_MAX_RETRIES=1
# AWS_S3_MAX_POOL_CONNECTIONS=50
# S3_RUNTIME_BUCKET_AUTOCREATE=False
# IMAGEKIT_CACHEFILE_DIR=
# IMAGEKIT_CACHE_PREFIX=
# IMAGEKIT_LEGACY_CACHEFILE_DIRS=CACHE/images
# IMAGEKIT_GENERATE_DURING_REQUESTS=False
# MEDIA_SELF_HEAL_BATCH_SIZE=25
# MEDIA_SELF_HEAL_LOCK_SECONDS=1800
# MEDIA_SELF_HEAL_MAX_QUEUE_DEPTH=100

# ---------------------------------------------------------------- Email (Resend)
RESEND_API_KEY=<from resend.com>
DEFAULT_FROM_EMAIL="aniShows <noreply@anishows.com>"
# RESEND_API_URL=https://api.resend.com
# RESEND_REQUEST_TIMEOUT=10

# ---------------------------------------------------------------- Auth
JWT_ISSUER=anishows.com
JWT_AUDIENCE=anishows-api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# G1 D-1 (decided: off). Whether the API also accepts a Django session cookie.
# The SPA never needs it: it sends a Bearer JWT (access token in memory; the
# refresh token is an httpOnly cookie read by its own view), the API never
# starts a session (REST_AUTH SESSION_LOGIN=False), and no template calls the
# API. Off, a Django admin session cannot drive the API either. The Django
# admin keeps its own session login. The code default (True) is for development.
API_SESSION_AUTH_ENABLED=False
# Social-link checks; without a key the check is skipped (core.W001).
GOOGLE_SAFE_BROWSING_API_KEY=
# GOOGLE_SAFE_BROWSING_FAIL_OPEN=False

# ---------------------------------------------------------------- Catalog
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_RATE_LIMIT_PER_MINUTE=30
MAL_CLIENT_ID=
# OFFLINE_IMPORT_TRENDING_RANK_LIMIT=50
# OFFLINE_RECONCILE_BATCH_SIZE=25
# OFFLINE_RECONCILE_CHUNK_SIZE=100
# OFFLINE_RECONCILE_MAX_ROUNDS=4
# OFFLINE_RECONCILE_ROUND_INTERVAL_MINUTES=15
# OFFLINE_RECONCILE_INTER_STAGE_DELAY_SECONDS=60
# OFFLINE_RECONCILE_WORKFLOW_LOCK_SECONDS=7200

# ---------------------------------------------------------------- Caching and limits
# PUBLIC_API_CACHE_WAIT_TIMEOUT_MS=30000
# PUBLIC_API_CACHE_WAIT_POLL_INTERVAL_MS=25
# PUBLIC_API_CACHE_LOCK_TTL_SECONDS=120
# PUBLIC_API_CACHE_STALE_TTL_SECONDS=900
# PUBLIC_API_CACHE_TTL_JITTER_SECONDS=30
# How often a web process looks for cache invalidations a Redis outage left
# pending (a process that saw the outage looks at once):
# PUBLIC_CACHE_PENDING_CHECK_SECONDS=10
# NOTIFICATION_UNREAD_CACHE_TTL=86400
# FORUM_VIEW_BUFFER_TTL_SECONDS=7200
# FORUM_VIEW_FLUSH_BATCH_SIZE=500
# USER_STATS_BACKSTOP_BATCH_SIZE=250
# USER_STATS_BACKSTOP_LOCK_SECONDS=1800
# USER_STATS_BACKSTOP_STALE_MINUTES=180
# USER_STATS_REFRESH_DEDUPE_TTL_SECONDS=30
# MAX_ACTIVE_IMPORT_JOBS_PER_USER=1
# MAX_IMPORT_JOBS_PER_DAY=5
# MAX_IMPORT_XML_ENTRIES=5000
# MAX_IMPORT_TASK_PAYLOAD_BYTES=524288
# ADMIN_SETTINGS_USE_CACHE=True
# ADMIN_SETTINGS_LOCAL_CACHE_TTL_SECONDS=2.0

# ---------------------------------------------------------------- Request logging (database)
# REQUEST_LOGGING_ENABLED=True
# REQUEST_LOG_SUCCESS_SAMPLE_RATE=0.05
# REQUEST_LOG_INCLUDE_QUERY_PARAMS=False
# REQUEST_LOG_INCLUDE_USER_AGENT=True

# ---------------------------------------------------------------- Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Defaults to GIT_SHA.
# SENTRY_RELEASE=
# SENTRY_SERVER_NAME=anishows-web
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
# /metrics basic auth. [refused] placeholder or shorter than 12; empty = disabled.
METRICS_ENABLED=true
METRICS_USERNAME=metrics
METRICS_PASSWORD=<generate>

# ---------------------------------------------------------------- Web push (G4, C-INT-3)
# Generate a P-256 key pair (docs in G4's spec); the frontend reads the public
# key from /api/v1/notifications/push/config/. Empty = push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<ops-email>

# ---------------------------------------------------------------- Processes and footprint
# Lean shared-host profile (the defaults): about 3 GB of memory limits with the
# bundled db, 3.5 GB during a rolling deploy (which briefly runs SCALE_WEB + 1
# replicas). Roomier: the runbook's second profile (SCALE_WEB=2 and more).
SCALE_WEB=1
# Workers per web replica (compose default 2).
GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=15
# GUNICORN_MAX_REQUESTS=2000
# GUNICORN_MAX_REQUESTS_JITTER=200
# GUNICORN_BACKLOG=4096
# GUNICORN_LOG_LEVEL=warning
# 1 = gunicorn access log on (default off with LOG_FORMAT=json).
# GUNICORN_ACCESS_LOG=0
CELERY_CONCURRENCY=1
# CELERY_WORKER_MAX_TASKS_PER_CHILD=
# CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=
# Image tags: normally passed in the shell (CI: sha-<commit>). A re-run
# without them keeps the live release (backups-data/deployed.env); these are
# only the first deploy's fallback.
# BACKEND_TAG=latest
# FRONTEND_TAG=latest
# Memory limits (docker-compose.prod.yml defaults shown: the lean profile).
# WEB_MEMORY_LIMIT=512M
# CELERY_MEMORY_LIMIT=640M
# BEAT_MEMORY_LIMIT=192M
# DB_MEMORY_LIMIT=768M
# REDIS_MEMORY_LIMIT=256M
# MINIO_MEMORY_LIMIT=256M
# CADDY_MEMORY_LIMIT=128M
# CLOUDFLARED_MEMORY_LIMIT=128M
# UMAMI_MEMORY_LIMIT=512M
# UMAMI_DB_MEMORY_LIMIT=256M
# BACKUP_MEMORY_LIMIT=256M
# unless-stopped (default) or on-failure:N (then add the boot hook: runbook).
# RESTART_POLICY=unless-stopped
# Container log rotation (per container).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
# 1 = prune this project's old images after a deploy (label-scoped).
# PRUNE_IMAGES=1

# ---------------------------------------------------------------- Analytics (Umami, optional)
# auto = on when UMAMI_DOMAIN is set.
ANALYTICS_ENABLED=auto
UMAMI_DOMAIN=
UMAMI_PUBLIC_ORIGIN=
# [refused when analytics is on]
UMAMI_DB_PASSWORD=<generate>
UMAMI_APP_SECRET=<generate>
# UMAMI_DB_USER=umami
# UMAMI_DB_NAME=umami
# UMAMI_POSTGRES_VERSION=17

# ---------------------------------------------------------------- Backups
# Backups of each kind kept on this host (each is a full DB dump + media).
BACKUP_KEEP=7
# Pre-migrate DB dumps kept (taken by deploy-prod.sh before a schema change).
BACKUP_KEEP_PRE_MIGRATE=3
# BACKUP_SCHEDULE="0 3 * * *"
# BACKUP_INCLUDE_MEDIA=1
# Off-site copy (owner decision G7 Q2), optional. An rclone remote path; empty
# = none (each run logs "Off-site upload skipped"). The remote is configured
# with RCLONE_CONFIG_<NAME>_* variables (no rclone.conf); after a change:
# scripts/deploy/compose.sh up -d --no-deps backup && make prod-offsite-list.
# Hetzner Storage Box (SFTP, SSH support on):
#   BACKUP_REMOTE=offsite:anishows-backups
#   RCLONE_CONFIG_OFFSITE_TYPE=sftp
#   RCLONE_CONFIG_OFFSITE_HOST=uXXXXXX.your-storagebox.de
#   RCLONE_CONFIG_OFFSITE_USER=uXXXXXX
#   RCLONE_CONFIG_OFFSITE_PORT=23
#   RCLONE_CONFIG_OFFSITE_PASS=<docker run --rm rclone/rclone obscure '<password>'>
# Backblaze B2 (a key restricted to the bucket):
#   BACKUP_REMOTE=offsite:<bucket>/anishows
#   RCLONE_CONFIG_OFFSITE_TYPE=b2
#   RCLONE_CONFIG_OFFSITE_ACCOUNT=<keyID>
#   RCLONE_CONFIG_OFFSITE_KEY=<applicationKey>
# Hetzner Object Storage (S3): TYPE=s3, PROVIDER=Other,
#   ENDPOINT=https://fsn1.your-objectstorage.com, ACCESS_KEY_ID, SECRET_ACCESS_KEY.
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
# The backup container turns unhealthy after this long without a success.
# BACKUP_MAX_AGE_HOURS=26
# How long a backup waits for a running one (0 = fail at once). deploy-prod.sh
# runs its pre-migrate dump with 1800.
# BACKUP_LOCK_WAIT_SECONDS=0

# ---------------------------------------------------------------- Deploy
# Deploys run from GitHub Actions (Deploy (Hetzner VPS), manual). Its secrets
# (VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_SSH_KNOWN_HOSTS, VPS_APP_DIR) live in
# GitHub, not here: docs/deploy/DEPLOY.md, "Deploying from GitHub Actions".
# One run past the refusals above, with a warning (emergencies only).
# ALLOW_INSECURE_DEFAULTS=0
# SKIP_ANILIST_SMOKE=0
# SKIP_PRE_MIGRATE_BACKUP=0
# 1 = use local images only (dry runs, air-gapped hosts).
# SKIP_PULL=0
# DEPLOY_LOG_DIR=backups-data/deploy-logs
# COMPOSE_PROJECT_NAME=anishows
