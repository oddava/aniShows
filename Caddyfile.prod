{
    email {$EMAIL_HOST_USER}
}

{$DOMAIN_NAME:localhost} {

    encode gzip zstd

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy (adjust as needed)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: https://www.google-analytics.com; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://youtube.com;"
        # Permissions policy
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        # Remove server header
        -Server
    }

    # API
    handle /api/* {
        reverse_proxy web:8000
    }

    # Django Admin (backend)
    handle /django-admin/* {
        reverse_proxy web:8000
    }

    # Django static (optional)
    handle /static/* {
        reverse_proxy web:8000
    }

    # MinIO Media - proxy /media/* to MinIO bucket
    # Note: /media/CACHE/* is also handled here when thumbnails are in S3
    handle_path /media/* {
        # Fix MIME types for common image formats (MinIO sometimes returns application/octet-stream)
        @webp path *.webp
        header @webp Content-Type "image/webp"

        @jpg path *.jpg *.jpeg
        header @jpg Content-Type "image/jpeg"

        @png path *.png
        header @png Content-Type "image/png"

        @gif path *.gif
        header @gif Content-Type "image/gif"

        rewrite * /anishows-media/media{path}
        reverse_proxy minio:9000 {
            header_up Host {upstream_hostport}
            # Fail gracefully if MinIO is unavailable - serve placeholder or return 404
            lb_try_duration 5s
            lb_try_interval 1s
        }
        # Add aggressive caching headers for media files
        header Cache-Control "public, max-age=31536000, immutable"
        header Vary "Accept"
        # Add cross-origin headers for images
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        # Handle errors gracefully
        handle_errors {
            rewrite * /api/v1/media/placeholder/{path}
            reverse_proxy web:8000
        }
    }

    # ImageKit CACHE - serve locally generated thumbnails (Unused when USE_S3=True)
    # handle_path /media/CACHE/* {
    #     root * /app/CACHE
    #     file_server
    #     header Cache-Control "public, max-age=31536000, immutable"
    # }

    # Image optimization endpoint - proxy to Django for on-demand resizing
    handle_path /media/resize/* {
        rewrite * /api/v1/media/resize/{path}
        reverse_proxy web:8000
    }

    # Static assets with aggressive caching
    handle /assets/* {
        root * /srv/frontend
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Favicon and icon files
    handle /favicon.ico {
        root * /srv/frontend
        file_server
        header Cache-Control "public, max-age=86400"
    }

    handle /apple-touch-icon.png {
        root * /srv/frontend
        file_server
        header Cache-Control "public, max-age=86400"
    }

    handle /icon.svg {
        root * /srv/frontend
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Frontend (STATIC) - Production mode
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
        # Cache HTML for 5 minutes (balance between performance and updates)
        header Cache-Control "public, max-age=300, must-revalidate"
    }

    log {
        output file /var/log/caddy/access.log
    }
}
