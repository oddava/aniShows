{
	# ACME account email for certificate issuance/recovery notifications.
	# Keep separate from application mail settings (e.g., RESEND/SMTP users).
	email {$CADDY_ACME_EMAIL:admin@anishows.local}
}

{$DOMAIN_NAME:localhost} {
	encode gzip zstd

	# Django spools a whole request body to disk before any auth check, so
	# cap it here. The largest real upload is the 10MB MAL XML import.
	request_body {
		max_size 12MB
	}

	# Security headers
	header {
		# Enable HSTS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Note: Content-Security-Policy is set by Django csp_middleware.py for backend routes
		# and in the frontend handle block below for static pages.
		# Note: Permissions-Policy header removed to prevent console warnings
		# Modern browsers handle feature permissions without this header
		# Remove server header
		-Server
	}

	# API
	handle /api/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			lb_policy least_conn
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 3
			health_uri /api/v1/health/
			health_interval 15s
			health_timeout 5s
			transport http {
				dial_timeout 5s
				read_timeout 30s
				write_timeout 30s
				keepalive 120s
			}
		}
	}

	# WebSockets are served by the same ASGI (uvicorn) workers as the API
	handle /ws/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			lb_policy random_choose 2
			lb_try_duration 10s
			lb_try_interval 500ms
			fail_duration 30s
			max_fails 3
			health_uri /api/v1/health/
			health_interval 15s
			health_timeout 5s
			transport http {
				dial_timeout 5s
				read_timeout 120s
				write_timeout 120s
				keepalive 120s
			}
		}
	}

	# Django Admin (backend)
	handle /django-admin/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000}
	}

	# Django static (optional)
	handle /static/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000}
	}

	# Metrics: public route, but the view requires basic auth with explicit,
	# non-default METRICS_USERNAME/METRICS_PASSWORD (else it is disabled).
	handle /metrics {
		reverse_proxy {$WEB_UPSTREAMS:web:8000}
	}

	# MinIO Media - proxy /media/* to MinIO bucket
	# Note: /media/CACHE/* is also handled here when thumbnails are in S3
	handle_path /media/* {
		# Read-only: MinIO would otherwise accept signed S3 writes and deletes
		# sent through this public route.
		@media_write not method GET HEAD
		respond @media_write 405

		# Fix MIME types for common image formats (MinIO sometimes returns application/octet-stream)
		@webp path *.webp
		header @webp Content-Type "image/webp"

		@jpg path *.jpg *.jpeg
		header @jpg Content-Type "image/jpeg"

		@png path *.png
		header @png Content-Type "image/png"

		@gif path *.gif
		header @gif Content-Type "image/gif"

		rewrite * /anishows-media/media{path}
		reverse_proxy minio:9000 {
			header_up Host {upstream_hostport}
			# Strip CORS headers from MinIO to avoid duplicates
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			# Strip upstream content type so extension-based header rules
			# above set a single canonical Content-Type.
			header_down -Content-Type
			# Fail gracefully if MinIO is unavailable - serve placeholder or return 404
			lb_try_duration 5s
			lb_try_interval 1s

			# Cache policy based on upstream response status.
			@media_success status 200 206
			handle_response @media_success {
				header Cache-Control "public, max-age=31536000, immutable"
				header Vary "Accept"
				copy_response
			}

			@media_error status 400 401 403 404 405 408 409 410 429 500 502 503 504
			handle_response @media_error {
				header Cache-Control "no-store"
				header CDN-Cache-Control "no-store"
				copy_response
			}
		}
		# Add cross-origin headers for images
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	}

	# ImageKit CACHE - serve locally generated thumbnails (Unused when USE_S3=True)
	# handle_path /media/CACHE/* {
	#     root * /app/CACHE
	#     file_server
	#     header Cache-Control "public, max-age=31536000, immutable"
	# }

	# Image optimization endpoint - proxy to Django for on-demand resizing
	handle_path /media/resize/* {
		rewrite * /api/v1/media/resize/{path}
		reverse_proxy {$WEB_UPSTREAMS:web:8000}
	}

	# Service worker - never cache to ensure updates are detected
	handle /sw.js {
		root * /srv/frontend
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
		header Pragma "no-cache"
		header Expires "0"
	}

	handle /workbox-*.js {
		root * /srv/frontend
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
		header Pragma "no-cache"
		header Expires "0"
	}

	# Service worker registration - never cache to ensure updates are detected
	handle /registerSW.js {
		root * /srv/frontend
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
		header Pragma "no-cache"
		header Expires "0"
	}

	# Static assets with aggressive caching
	handle /assets/* {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Favicon and icon files
	handle /favicon.ico {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle /apple-touch-icon.png {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle /icon.svg {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Serve user-specific profile link previews for major crawlers/bots.
	@profile_share_crawlers {
		path /u/*
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|discordbot|whatsapp|telegram(?:bot)?|linkedinbot|skypeuripreview|googlebot|bingbot|duckduckbot|applebot|pinterestbot|vkshare|line|kakaotalk-scrap)
	}
	handle @profile_share_crawlers {
		reverse_proxy {$WEB_UPSTREAMS:web:8000}
	}

	# Frontend (STATIC) - Production mode
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
		# No cache for HTML to ensure fresh content on every deploy
		header Cache-Control "public, max-age=0, must-revalidate, no-cache"
		header Last-Modified "{http.request.time}"
		# Debug header to identify deployment
		header X-Deployment-Time "{http.request.time}"
		# Content Security Policy for the React Frontend
		header Content-Security-Policy "default-src 'self'; script-src 'self' {$UMAMI_PUBLIC_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: {$UMAMI_PUBLIC_ORIGIN} https://fonts.googleapis.com https://fonts.gstatic.com wss:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com;"
	}

	log {
		output file /var/log/caddy/access.log
	}
}

{$UMAMI_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy umami:3000

	log {
		output file /var/log/caddy/umami-access.log
	}
}

www.oddava.me {
	redir https://oddava.me{uri} permanent
}

oddava.me {
	encode zstd gzip

	reverse_proxy oddava-app:4321 {
		# oddava-app relies on explicit forwarded host/proto/client metadata
		# for canonical URL generation and origin-aware behavior.
		# Keep these header_up directives even though Caddy may warn that
		# some overlap with defaults.
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
