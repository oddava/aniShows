# Production edge. Three deploy modes share every route below (snippet "app"):
#
#   proxy   (default) an existing reverse proxy on the host terminates TLS and
#           forwards plain HTTP to Caddy on 127.0.0.1:CADDY_PROXY_PORT (or over
#           its Docker network). Caddy runs no ACME. CADDY_SITE_ADDRESS is ":80".
#   public  Caddy owns the host's 80/443, gets certificates by ACME and
#           redirects HTTP to HTTPS. CADDY_SITE_ADDRESS is the domain.
#   tunnel  Cloudflare Tunnel (cloudflared) is the only client. Caddy serves
#           plain HTTP on :80 inside the compose network, publishes no host
#           port and runs no ACME. CADDY_SITE_ADDRESS is ":80".
#
# deploy-prod.sh derives the CADDY_* variables from CADDY_MODE; see
# docs/deploy/DEPLOY.md for the proxy chain and .env.production.example.
{
	# ACME account email for certificate issuance/recovery notifications
	# (public mode only; the other modes have no site that needs a certificate).
	email {$CADDY_ACME_EMAIL:admin@anishows.local}

	servers {
		# Peers whose client-IP and X-Forwarded-Proto headers Caddy believes.
		# Proxy mode: the host's reverse proxy only (CADDY_TRUSTED_PROXIES,
		# required; deploy-prod.sh refuses to start without it). Tunnel mode:
		# the edge network (cloudflared + Caddy only) and loopback. Public
		# mode: loopback only, so a client can never choose its own address.
		# {client_ip} below resolves through this. Values: scripts/deploy/env.sh.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/8 ::1/128}
		# X-Forwarded-For (proxy mode) is read right to left, skipping trusted
		# peers: entries a client sent ahead of its real address are ignored.
		trusted_proxies_strict
		# Proxy/public: X-Forwarded-For. Tunnel: CF-Connecting-IP (cloudflared
		# sets it to the address Cloudflare saw).
		client_ip_headers {$CADDY_CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

# Every reverse_proxy to Django sends exactly one X-Forwarded-For entry: the
# real client. The app trusts exactly one proxy hop (Caddy), in every mode:
# DRF NUM_PROXIES=1 and get_client_ip() both read that single entry, so each
# client gets its own throttle bucket. X-Forwarded-Proto is Caddy's default:
# its own scheme, or the trusted peer's ("https" from the host's proxy or
# Cloudflare) in proxy and tunnel mode.
(django) {
	header_up X-Forwarded-For {client_ip}
}

(security_headers) {
	header {
		# Matches Django's SECURE_HSTS_* (deploy-prod.sh builds both from the
		# same env). Default: 1 year; includeSubDomains and preload are opt-in.
		Strict-Transport-Security "{$CADDY_HSTS_HEADER:max-age=31536000}"
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Note: Content-Security-Policy is set by Django csp_middleware.py for backend routes
		# and in the frontend handle block below for static pages.
		# Remove server header
		-Server
	}
	# Referrer policy (deferred, so it also replaces Django's). Account-link
	# pages are excluded: the SPA block sends "no-referrer" for them.
	@referrer_default not path /reset-password/* /verify-email/* /confirm-email-change/*
	header @referrer_default {
		Referrer-Policy "strict-origin-when-cross-origin"
		defer
	}
}

# Operator-only routes (owner decision D-9): /metrics, readiness and the
# Django admin. ADMIN_ALLOW_CIDRS is a space-separated CIDR list; unset or
# empty it is 100::/64 (the RFC 6666 discard prefix: no client has that
# address), so every client gets 403 and only Caddy's own loopback (matched
# below by TCP peer) gets through. deploy-prod.sh refuses wide-open lists. {client_ip}
# is the real client in every mode (see trusted_proxies above). Requests from
# Caddy's own loopback (deploy smoke tests) always pass; that is matched on
# the TCP peer (remote_ip), so no header can claim it. Imported inside each
# handle block: a top-level respond would sort after handle and never run.
(operator_gate) {
	@operator_denied_{args[0]} {
		not client_ip {$ADMIN_ALLOW_CIDRS:100::/64}
		not remote_ip 127.0.0.1/8 ::1/128
	}
	respond @operator_denied_{args[0]} 403
}

# Access logs: rotated (10 MiB x 5) and without secrets: account-link tokens
# (reset/verify/email-change) and OAuth/secret query values, in the URI and
# in the Referer a page sends and in redirects' Location. Credentials headers
# are redacted by Caddy itself.
(access_log) {
	log {
		output file /var/log/caddy/{args[0]} {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			request>uri regexp "(?i)(/(?:reset-password|password-reset-confirm|verify-email|confirm-email-change|email-change|activate)/)[^?#\s]*|([?&](?:code|token|uid|key|signature|password|secret|access|refresh)=)[^&#\s]*" "${1}${2}<redacted>"
			request>headers>Referer regexp "(?i)(/(?:reset-password|password-reset-confirm|verify-email|confirm-email-change|email-change|activate)/)[^?#\s]*|([?&](?:code|token|uid|key|signature|password|secret|access|refresh)=)[^&#\s]*" "${1}${2}<redacted>"
			resp_headers>Location regexp "(?i)(/(?:reset-password|password-reset-confirm|verify-email|confirm-email-change|email-change|activate)/)[^?#\s]*|([?&](?:code|token|uid|key|signature|password|secret|access|refresh)=)[^&#\s]*" "${1}${2}<redacted>"
		}
	}
}

(api_proxy) {
	reverse_proxy {$WEB_UPSTREAMS:web:8000} {
		import django
		lb_policy least_conn
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 30s
		max_fails 3
		# Liveness, never readiness: a database blip must not eject
		# every replica at once.
		health_uri /api/v1/health/
		health_interval 15s
		health_timeout 5s
		transport http {
			dial_timeout 5s
			read_timeout 30s
			write_timeout 30s
			keepalive 120s
		}
	}
}

(app) {
	encode gzip zstd

	# Django spools a whole request body to disk before any auth check, so
	# cap it here. The largest real upload is the 10MB MAL XML import.
	request_body {
		max_size 12MB
	}

	import security_headers

	# Readiness (live DB/cache/migration checks): operator-only.
	handle /api/v1/health/ready/ {
		import operator_gate ready
		import api_proxy
	}

	# API
	handle /api/* {
		import api_proxy
	}

	# WebSockets are served by the same ASGI (uvicorn) workers as the API
	handle /ws/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
			lb_policy random_choose 2
			lb_try_duration 10s
			lb_try_interval 500ms
			fail_duration 30s
			max_fails 3
			health_uri /api/v1/health/
			health_interval 15s
			health_timeout 5s
			transport http {
				dial_timeout 5s
				read_timeout 120s
				write_timeout 120s
				keepalive 120s
			}
		}
	}

	# Django Admin (backend)
	handle /django-admin/* {
		import operator_gate admin
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
		}
	}

	# Django static (whitenoise)
	handle /static/* {
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
		}
	}

	# Metrics: the view also requires basic auth with explicit, non-default
	# METRICS_USERNAME/METRICS_PASSWORD (else it is disabled).
	handle /metrics {
		import operator_gate metrics
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
		}
	}

	# Image optimization endpoint - proxy to Django for on-demand resizing.
	# (handle_path strips the prefix, so it must come before /media/*.)
	handle_path /media/resize/* {
		rewrite * /api/v1/media/resize/{path}
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
		}
	}

	# MinIO Media - proxy /media/* to MinIO bucket
	# Note: /media/CACHE/* is also handled here when thumbnails are in S3
	handle_path /media/* {
		# Read-only: MinIO would otherwise accept signed S3 writes and deletes
		# sent through this public route.
		@media_write not method GET HEAD
		respond @media_write 405

		# Fix MIME types for common image formats (MinIO sometimes returns application/octet-stream)
		@webp path *.webp
		header @webp Content-Type "image/webp"

		@jpg path *.jpg *.jpeg
		header @jpg Content-Type "image/jpeg"

		@png path *.png
		header @png Content-Type "image/png"

		@gif path *.gif
		header @gif Content-Type "image/gif"

		rewrite * /anishows-media/media{path}
		reverse_proxy minio:9000 {
			header_up Host {upstream_hostport}
			# Strip CORS headers from MinIO to avoid duplicates
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			# Strip upstream content type so extension-based header rules
			# above set a single canonical Content-Type.
			header_down -Content-Type
			# Fail gracefully if MinIO is unavailable - serve placeholder or return 404
			lb_try_duration 5s
			lb_try_interval 1s

			# Cache policy based on upstream response status.
			@media_success status 200 206
			handle_response @media_success {
				header Cache-Control "public, max-age=31536000, immutable"
				header Vary "Accept"
				copy_response
			}

			@media_error status 400 401 403 404 405 408 409 410 429 500 502 503 504
			handle_response @media_error {
				header Cache-Control "no-store"
				header CDN-Cache-Control "no-store"
				copy_response
			}
		}
		# Add cross-origin headers for images
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	}

	# The web-push worker: never cached, so browsers pick up a new one at once.
	handle /service-worker.js {
		root * /srv/frontend
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
	}

	# Old Workbox/VitePWA files (no longer built, C-INT-7): a plain 404, never
	# index.html served as a script. public/boot.js unregisters such workers.
	@legacy_pwa path /sw.js /registerSW.js /workbox-*.js
	handle @legacy_pwa {
		header Cache-Control "no-store"
		respond 404
	}

	# Static assets with aggressive caching
	handle /assets/* {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Favicon and icon files
	handle /favicon.ico {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle /apple-touch-icon.png {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle /icon.svg {
		root * /srv/frontend
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Serve user-specific profile link previews for major crawlers/bots.
	@profile_share_crawlers {
		path /u/*
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|discordbot|whatsapp|telegram(?:bot)?|linkedinbot|skypeuripreview|googlebot|bingbot|duckduckbot|applebot|pinterestbot|vkshare|line|kakaotalk-scrap)
	}
	handle @profile_share_crawlers {
		reverse_proxy {$WEB_UPSTREAMS:web:8000} {
			import django
		}
	}

	# Frontend (STATIC) - Production mode
	handle {
		# Account-link pages carry a secret in their URL: send no Referer from
		# them (their assets and API calls would otherwise carry the token).
		@account_link_pages path /reset-password/* /verify-email/* /confirm-email-change/*
		header @account_link_pages Referrer-Policy "no-referrer"
		root * /srv/frontend
		try_files {path} /index.html
		file_server
		# No cache for HTML to ensure fresh content on every deploy
		header Cache-Control "public, max-age=0, must-revalidate, no-cache"
		header Last-Modified "{http.request.time}"
		# Debug header to identify deployment
		header X-Deployment-Time "{http.request.time}"
		# Content Security Policy for the React Frontend
		header Content-Security-Policy "default-src 'self'; script-src 'self' {$UMAMI_PUBLIC_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: {$UMAMI_PUBLIC_ORIGIN} https://fonts.googleapis.com https://fonts.gstatic.com wss:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com;"
	}

	import access_log access.log
}

# The application. Public mode: the domain (ACME + HTTP->HTTPS redirect).
# Proxy and tunnel mode: ":80", any Host (Django's ALLOWED_HOSTS still checks it).
{$CADDY_SITE_ADDRESS:localhost} {
	import app
}

# Umami analytics (the "analytics" compose profile). Public mode: its domain;
# proxy and tunnel mode: "http://<domain>" (no ACME). The default never matches a real
# request, so the config loads when analytics is off.
{$CADDY_UMAMI_SITE_ADDRESS:http://umami.invalid} {
	encode gzip zstd

	import security_headers

	reverse_proxy umami:3000 {
		header_up X-Forwarded-For {client_ip}
	}

	import access_log umami-access.log
}

# Extra sites for this mode only (infra/caddy/sites-<mode>.d/*.caddy, mounted
# at /etc/caddy/sites-<mode>.d). Public mode keeps serving the owner's other
# site on this Caddy, as before; proxy and tunnel mode add none (the host's
# proxy or cloudflared routes other projects itself). An empty directory is fine.
import /etc/caddy/sites-{$CADDY_MODE:proxy}.d/*.caddy
