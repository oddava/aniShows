{
  "CELERY_BEAT_SCHEDULE": {
    "backfill-theme-youtube-urls-evening": {
      "kwargs": {
        "limit": 100
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 30 20 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.themes.backfill_theme_youtube_urls"
    },
    "backfill-theme-youtube-urls-morning": {
      "kwargs": {
        "limit": 100
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 30 8 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.themes.backfill_theme_youtube_urls"
    },
    "check-new-episodes": {
      "options": {
        "queue": "default"
      },
      "schedule": "<crontab: 0 */6 * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.notifications.check_new_episodes"
    },
    "cleanup-old-notifications": {
      "kwargs": {
        "days": 90
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 30 2 * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.notifications.cleanup_old_notifications_task"
    },
    "cleanup-task-results-daily": {
      "kwargs": {
        "batch_size": 1000,
        "days": 7
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 1 * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.cleanup_tasks.cleanup_old_task_results"
    },
    "collect-queue-metrics-minute": {
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: * * * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.cleanup_tasks.collect_queue_metrics"
    },
    "derive-airing-hourly": {
      "kwargs": {
        "limit": 500,
        "sync_type": "airing"
      },
      "options": {
        "queue": "high_priority"
      },
      "schedule": "<crontab: 30 * * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.sync.sync_anime_catalog"
    },
    "enrich-metadata-daily": {
      "kwargs": {
        "batch_size": 100,
        "mode": "backfill"
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 3 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.metadata.enrich_metadata"
    },
    "flush-forum-view-counts-minute": {
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: * * * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.cleanup_tasks.flush_forum_view_counts"
    },
    "generate-recommendations-daily": {
      "kwargs": {
        "limit": 10
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 5 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.recommendations.generate_recommendations"
    },
    "heal-missing-media-30min": {
      "kwargs": {
        "batch_size": 25
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: */30 * * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.images.heal_missing_anime_media"
    },
    "health-check-workers-hourly": {
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 15 * * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.cleanup_tasks.health_check_workers"
    },
    "reconcile-offline-catalog-sync-hourly": {
      "kwargs": {
        "anime_ids": [],
        "batch_size": 25,
        "chunk_size": 100,
        "max_rounds": 4,
        "require_themes": true,
        "round_interval_minutes": 15,
        "strict": false
      },
      "options": {
        "queue": "batch"
      },
      "schedule": "<crontab: 45 * * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.offline_catalog.reconcile_offline_catalog_sync"
    },
    "send-pending-notifications": {
      "options": {
        "queue": "default"
      },
      "schedule": "<crontab: */10 * * * * (m/h/dM/MY/d)>",
      "task": "apps.core.tasks.notifications.send_pending_notifications"
    },
    "sync-airing-schedule-daily": {
      "kwargs": {
        "phases": [
          "sync",
          "cleanup",
          "backfill"
        ]
      },
      "options": {
        "queue": "high_priority"
      },
      "schedule": "<crontab: 45 1 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.airing.sync_airing_workflow"
    },
    "sync-popular-weekly": {
      "kwargs": {
        "limit": 500,
        "sync_type": "airing"
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 2 * * 1 (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.sync.sync_anime_catalog"
    },
    "sync-seasonal-daily": {
      "kwargs": {
        "limit": 100,
        "sync_type": "seasonal"
      },
      "options": {
        "queue": "default"
      },
      "schedule": "<crontab: 0 2 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.sync.sync_anime_catalog"
    },
    "sync-themes-daily": {
      "kwargs": {
        "limit": 500
      },
      "options": {
        "queue": "high_priority"
      },
      "schedule": "<crontab: 0 6 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.themes.sync_theme_songs"
    },
    "sync-themes-retry": {
      "kwargs": {
        "limit": 200,
        "retry_failed": true
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 18 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.themes.sync_theme_songs"
    },
    "sync-trending-hourly": {
      "kwargs": {
        "limit": 50,
        "sync_type": "trending"
      },
      "options": {
        "queue": "high_priority"
      },
      "schedule": "<crontab: 5 * * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.sync.sync_anime_catalog"
    },
    "sync-upcoming-weekly": {
      "kwargs": {
        "limit": 100,
        "sync_type": "next_season"
      },
      "options": {
        "queue": "default"
      },
      "schedule": "<crontab: 30 3 * * 0 (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.sync.sync_anime_catalog"
    },
    "sync-watch-episodes-airing-every-6-hours": {
      "kwargs": {
        "force": true,
        "statuses": [
          "Airing",
          "Upcoming"
        ]
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 15 */6 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.watch_episodes.sync_watch_episodes_batch"
    },
    "update-relation-slugs-daily": {
      "kwargs": {
        "batch_size": 100
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 30 4 * * * (m/h/dM/MY/d)>",
      "task": "apps.animes.tasks.franchises.update_relation_slugs"
    },
    "update-user-stats-hourly": {
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 10 * * * * (m/h/dM/MY/d)>",
      "task": "apps.users.tasks.update_all_user_stats"
    },
    "user-maintenance-daily": {
      "kwargs": {
        "cleanup_imports": true,
        "cleanup_unverified": true,
        "import_days": 30,
        "unverified_days": 7
      },
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 7 * * * (m/h/dM/MY/d)>",
      "task": "apps.users.tasks.run_user_maintenance_workflow"
    },
    "warm-profile-cache-hourly": {
      "options": {
        "queue": "low_priority"
      },
      "schedule": "<crontab: 0 * * * * (m/h/dM/MY/d)>",
      "task": "apps.users.tasks.warm_profile_cache"
    }
  },
