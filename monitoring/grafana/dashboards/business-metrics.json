          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(user_imports_processed_total{status=\"success\"}[1h])) by (source) / sum(rate(user_imports_processed_total[1h])) by (source)",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
