      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(external_api_calls_total{status=\"failure\"}[5m])) by (service) / sum(rate(external_api_calls_total[5m])) by (service)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "API Error Rate by Service",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"text": "CLOSED"}}, "type": "value"},
            {"options": {"1": {"text": "OPEN"}}, "type": "value"},
            {"options": {"2": {"text": "HALF_OPEN"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
