      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum(rate(external_api_call_duration_seconds_bucket{service=\"anilist\"}[5m])) by (le))",
